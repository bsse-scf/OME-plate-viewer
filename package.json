{
  "name": "ome-plate-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "In-browser viewer for high-content screening plates: drop a plate folder, and it is served as a virtual OME-Zarr plate and shown in Neuroglancer. No installation, no upload, no backend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:browser": "npm run build && node tests/browser/run.mjs"
  },
  "dependencies": {
    "neuroglancer": "2.41.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "puppeteer-core": "^23.10.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.11"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.25.12": true
  }
}
